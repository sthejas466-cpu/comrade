# ─── Backend Environment Configuration ───────────────────────────────────────
# Copy this to .env and fill in your values. NEVER commit .env to git.

# Server
PORT=3001
NODE_ENV=production

# Security — change these in production!
JWT_SECRET=replace_with_a_strong_random_secret_64_chars_minimum
POLE_API_KEY=replace_with_a_strong_random_pole_api_key

# CORS — comma-separated list of allowed frontend origins
CLIENT_ORIGIN=https://your-frontend-domain.com,http://localhost:5173

# Gemini AI (optional — falls back to mock summaries if not set)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Database path (default: ./comrade.db)
# DB_PATH=./comrade.db
